# Names only. Provide real stage-specific values outside Git.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
BILLING_IAM_JWKS_URI=
IAM_JWT_ISSUER=
IAM_JWT_AUDIENCE=
BILLING_IAM_ORIGIN=
# Compose supplies /run/billing-iam/service-token; direct launches must set an absolute path.
BILLING_IAM_SERVICE_TOKEN_FILE=
BILLING_IAM_LOCAL_DEVELOPMENT=false
# Private Appointments owner read; use a separately provisioned service credential.
BILLING_APPOINTMENTS_ORIGIN=
BILLING_APPOINTMENTS_SERVICE_TOKEN_FILE=
BILLING_APPOINTMENTS_LOCAL_DEVELOPMENT=false
# Outbox relay is opt-in after broker credentials and consumer bindings exist.
BILLING_OUTBOX_RELAY_ENABLED=false
BILLING_RABBITMQ_URI_FILE=
BILLING_RABBITMQ_EXCHANGE=billing.events
BILLING_RABBITMQ_LOCAL_DEVELOPMENT=false
BILLING_OUTBOX_INTERVAL=PT5S
BILLING_OUTBOX_BATCH_SIZE=10
# Separate mounted public trust for private service routes; no staff keys/roles.
BILLING_SERVICE_JWT_PUBLIC_KEY_FILE=
BILLING_SERVICE_JWT_ISSUER=
BILLING_SERVICE_JWT_AUDIENCE=
BILLING_WORKER_SERVICE_SUBJECT=
BILLING_CLINICAL_SERVICE_SUBJECT=
